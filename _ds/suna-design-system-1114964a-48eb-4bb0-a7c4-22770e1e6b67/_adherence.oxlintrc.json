{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:ThmanyahSerifDisplay|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: ThmanyahSerifDisplay, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|size|lang|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, color, size, lang, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|outline|ghost)$/]",
        "message": "<Badge> variant must be one of 'filled' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:orange|white|black)$/]",
        "message": "<Badge> color must be one of 'orange' | 'white' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<Badge> lang must be one of 'ar' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|lang|muted|align|style|key|ref|className|style|children)$/]",
        "message": "<Caption> doesn't accept that prop. Declared props: children, size, color, lang, muted, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:body|caption|label|title)$/]",
        "message": "<Caption> size must be one of 'body' | 'caption' | 'label' | 'title'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:white|black|orange|muted)$/]",
        "message": "<Caption> color must be one of 'white' | 'black' | 'orange' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<Caption> lang must be one of 'ar' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<Caption> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|lang|size|tracking|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, lang, size, tracking, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:orange|white|black|muted)$/]",
        "message": "<Eyebrow> color must be one of 'orange' | 'white' | 'black' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<Eyebrow> lang must be one of 'ar' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:micro|label|sm)$/]",
        "message": "<Eyebrow> size must be one of 'micro' | 'label' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tracking'] > Literal[value!=/^(?:wide|wider|widest)$/]",
        "message": "<Eyebrow> tracking must be one of 'wide' | 'wider' | 'widest'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|lang|weight|align|uppercase|style|key|ref|className|style|children)$/]",
        "message": "<Headline> doesn't accept that prop. Declared props: children, size, color, lang, weight, align, uppercase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|headline|subheadline|title)$/]",
        "message": "<Headline> size must be one of 'display' | 'headline' | 'subheadline' | 'title'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:white|black|orange)$/]",
        "message": "<Headline> color must be one of 'white' | 'black' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<Headline> lang must be one of 'ar' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:light|regular|medium|bold|black)$/]",
        "message": "<Headline> weight must be one of 'light' | 'regular' | 'medium' | 'bold' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<Headline> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:ratio|bg|children|style|key|ref|className|style|children)$/]",
        "message": "<PostFrame> doesn't accept that prop. Declared props: ratio, bg, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:square|portrait|story|landscape|widescreen)$/]",
        "message": "<PostFrame> ratio must be one of 'square' | 'portrait' | 'story' | 'landscape' | 'widescreen'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|label|color|labelColor|lang|size|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: number, label, color, labelColor, lang, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:orange|white|black)$/]",
        "message": "<StatBlock> color must be one of 'orange' | 'white' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='labelColor'] > Literal[value!=/^(?:white|black|orange)$/]",
        "message": "<StatBlock> labelColor must be one of 'white' | 'black' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<StatBlock> lang must be one of 'ar' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|headline|title)$/]",
        "message": "<StatBlock> size must be one of 'display' | 'headline' | 'title'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
